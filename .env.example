# Copy to .env for local development. These are non-secret development defaults.
DATABASE_URL=sqlite:///./data/docustruct.db
STORAGE_ROOT=./data/uploads
MAX_UPLOAD_BYTES=10485760
EXTRACTION_PROVIDER=heuristic
REVIEW_CONFIDENCE_THRESHOLD=0.80
# Optional future hosted provider credential; never commit a real value.
LLM_API_KEY=

